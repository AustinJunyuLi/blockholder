% Puts the frame title in the banner
% TODO:
% title page

\DeclareOptionBeamer{small}{%
  \setbeamertemplate{banner}[ucl][1]%
  \setbeamertemplate{frametitle}[one line]%
}
\DeclareOptionBeamer{large}{%
  \setbeamertemplate{banner}[ucl][1.5]%
  \setbeamertemplate{frametitle}[two lines]%
}

% reset headline to default
\setbeamertemplate{headline}[default]

% set the colours from banner
\setbeamercolor*{frametitle}{use=banner,fg=banner.fg}
\def\ucl@color@noop{%
  \@ifnextchar[{\ucl@color@noop@opt}{\ucl@color@noop@noopt}%
}
\def\ucl@color@noop@opt[#1]#2{}
\def\ucl@color@noop@noopt#1{}
\newcommand{\ucl@sanitise@titlecolors}{%
  % Avoid variable color-coding in the black header (keep titles white).
  % Use \let (not \renewcommand) so this works even if the macros are undefined.
  \let\textcolor\@secondoftwo
  \let\color\ucl@color@noop
  \let\choice\@firstofone
  \let\obs\@firstofone
  \let\outcome\@firstofone
}

% puts the title on one line, and subtitle below
\defbeamertemplate{frametitle}{two lines}{%
  \begin{beamercolorbox}[ignorebg,ht=\bannerheight]{frametitle}%
    \vbox to\bannerheight{ % chktex 1
      \vspace{1ex}%
      \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}%
      \strut\begingroup\ucl@sanitise@titlecolors\insertframetitle\endgroup\strut\par%
      {%
        \ifx\insertframesubtitle\@empty%
        \else%
        {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\begingroup\ucl@sanitise@titlecolors\insertframesubtitle\endgroup\strut\par}%
        \fi
      }%
      \vfil%
    }
    \end{beamercolorbox}
    \ifbeamercolorempty[bg]{banner stripe}{}{\vspace{\stripeheight}}%
  }

% puts the title and subtitle on the same line
\defbeamertemplate{frametitle}{one line}{%
  \begin{beamercolorbox}[ignorebg,ht=\bannerheight]{frametitle}%
    \vbox to\bannerheight{ % chktex 1
      \vspace{1ex}%
      \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}%
      \strut\begingroup\ucl@sanitise@titlecolors\insertframetitle\endgroup\strut%
      {%
        \ifx\insertframesubtitle\@empty%
        \else%
        {\hspace{0.6em}\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\begingroup\ucl@sanitise@titlecolors\insertframesubtitle\endgroup\strut}%
        \fi
      }%
      \par%
      \vfil%
    }
  \end{beamercolorbox}
  \ifbeamercolorempty[bg]{banner stripe}{}{\vspace{\stripeheight}}%
  }


% this ensures the title page doesn't overlap the banner
\addtobeamertemplate{title page}{%
  \vspace{\bannerheight}%
  \ifbeamercolorempty[bg]{banner stripe}{}{\vspace{\stripeheight}}%
}{}


\ExecuteOptionsBeamer{large}
\ProcessOptionsBeamer%
